# SQLite file. Local dev default shown; on Render use /var/data/viet-cinco.sqlite
DATABASE_PATH=./data/viet-cinco.sqlite
# IANA timezone defining the "local calendar day" for repeated-matchup rules and date display
APP_TIMEZONE=America/Los_Angeles
# Optional: bootstrap the first admin at startup (only used when no users exist). Remove afterwards.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Optional scheduled backups (hours between backups; 0 disables) and retention
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
# Optional off-host backup target (any S3-compatible bucket)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=viet-cinco/
